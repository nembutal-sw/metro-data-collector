# 애플리케이션 기본 설정
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_TIMEZONE=Asia/Seoul
LOG_LEVEL=INFO

# Docker Compose 내부 PostgreSQL 연결 정보
# 호스트에서 API를 직접 실행할 때는 db를 localhost로 변경합니다.
DATABASE_URL=postgresql://metro:metro@db:5432/metro

# [필수/내부] POST /api/v1/admin/sync/* 보호용 키
# 외부에서 발급받는 값이 아니라 충분히 긴 임의 문자열을 생성해 사용합니다.
ADMIN_API_KEY=

# [필수/외부 조회] 경로 계산 API 소비자 키의 SHA-256 해시 목록
# 원문 키는 저장하지 않습니다. 여러 해시는 쉼표로 구분합니다.
# 보호 대상: /odsay/v1/api/searchPubTransPathT, /odsay/v1/api/pointSearch,
#            /api/v1/stations/nearby, /api/v1/travel-time,
#            /api/v1/routes, /api/v1/routes/last-train
# 생성 예: printf %s 'metro_live_...' | sha256sum
PUBLIC_API_KEY_HASHES=

# [선택/해당 API 사용 시] 서울 열린데이터광장 일반 Open API 인증키
# 발급: https://data.seoul.go.kr/
SEOUL_OPEN_DATA_API_KEY=

# [선택/실시간 사용 시] 서울 열린데이터광장 실시간 지하철 전용 인증키
# 일반 인증키와 별도 발급되는 계정이면 별도 값을 입력합니다.
# 같은 키를 사용하도록 발급된 경우 SEOUL_OPEN_DATA_API_KEY와 동일한 값을 입력합니다.
SEOUL_SUBWAY_REALTIME_API_KEY=

# [선택/REST API 사용 시] 공공데이터포털 서비스키
# 승인받은 공공데이터포털 REST API 호출에 사용합니다. 아래의 현재 서울·인천
# 직접 다운로드 URL은 인증키 없이 공개되므로 정적 시간표 수집에는 필요하지 않습니다.
# 발급: https://www.data.go.kr/
DATA_GO_KR_SERVICE_KEY=

# [선택] 국가철도공단/KRIC Open API가 별도 인증을 요구할 때 사용합니다.
# 파일 다운로드만 사용하는 단계에서는 비워 둘 수 있습니다.
KRIC_API_KEY=

# [선택] MeetBack 연동 전에 서버가 직접 도보 경로를 계산할 때 사용합니다.
# 초기 버전은 도보시간을 요청값으로 받으므로 비워 둘 수 있습니다.
KAKAO_MOBILITY_REST_API_KEY=

# [설정값/키 아님] 서울 1~9호선 전체 시간표의 현재 공식 다운로드 URL
# 데이터셋 페이지에서 파일 개정 시 URL을 재검증한 뒤 입력합니다.
SEOUL_TIMETABLE_DOWNLOAD_URL=https://www.data.go.kr/cmm/cmm/fileDownload.do?atchFileId=FILE_000000003657575&fileDetailSn=1&insertDataPrcus=N
SEOUL_TIMETABLE_EFFECTIVE_FROM=2026-06-16

# [설정값/키 아님] 인천 1·2호선 공식 방향·요일별 CSV 또는 Open API URL
# 인증이 필요한 URL은 키를 직접 넣지 말고 serviceKey={serviceKey} 형태로 적습니다.
# 실행 시 DATA_GO_KR_SERVICE_KEY가 URL 인코딩되어 대입되며 원본 URL에는 기록되지 않습니다.
INCHEON_1_WEEKDAY_UP_URL=https://www.data.go.kr/cmm/cmm/fileDownload.do?atchFileId=FILE_000000003123198&fileDetailSn=1&insertDataPrcus=N
INCHEON_1_WEEKDAY_DOWN_URL=https://www.data.go.kr/cmm/cmm/fileDownload.do?atchFileId=FILE_000000003123201&fileDetailSn=1&insertDataPrcus=N
INCHEON_1_HOLIDAY_UP_URL=https://www.data.go.kr/cmm/cmm/fileDownload.do?atchFileId=FILE_000000003123200&fileDetailSn=1&insertDataPrcus=N
INCHEON_1_HOLIDAY_DOWN_URL=https://www.data.go.kr/cmm/cmm/fileDownload.do?atchFileId=FILE_000000003123202&fileDetailSn=1&insertDataPrcus=N
INCHEON_2_WEEKDAY_UP_URL=https://www.data.go.kr/cmm/cmm/fileDownload.do?atchFileId=FILE_000000003220868&fileDetailSn=1&insertDataPrcus=N
INCHEON_2_WEEKDAY_DOWN_URL=https://www.data.go.kr/cmm/cmm/fileDownload.do?atchFileId=FILE_000000003220883&fileDetailSn=1&insertDataPrcus=N
INCHEON_2_HOLIDAY_UP_URL=https://www.data.go.kr/cmm/cmm/fileDownload.do?atchFileId=FILE_000000003220877&fileDetailSn=1&insertDataPrcus=N
INCHEON_2_HOLIDAY_DOWN_URL=https://www.data.go.kr/cmm/cmm/fileDownload.do?atchFileId=FILE_000000003220879&fileDetailSn=1&insertDataPrcus=N
INCHEON_TIMETABLE_EFFECTIVE_FROM=2025-06-28

# 원본 및 임시 데이터 경로
RAW_DATA_DIR=./data/raw
STAGING_DATA_DIR=./data/staging

# 외부 HTTP 정책
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3

# 외부 API 보호 정책: 실제 승인 한도보다 낮게 설정해 여유분을 남깁니다.
# 재시도도 실제 요청 건수에 포함되며, 429 응답의 Retry-After 동안 호출을 차단합니다.
EXTERNAL_API_MIN_INTERVAL_SECONDS=0.25
DATA_GO_KR_DAILY_REQUEST_BUDGET=9000
KRIC_DAILY_REQUEST_BUDGET=900
SEOUL_OPEN_DATA_DAILY_REQUEST_BUDGET=900

# [설정값/키 아님] 서울교통공사 환승역 거리·소요시간 공식 CSV
# 공개 파일 다운로드이므로 위 API 일일 예산을 소비하지 않습니다.
SEOUL_TRANSFER_DISTANCE_DOWNLOAD_URL=https://www.data.go.kr/cmm/cmm/fileDownload.do?atchFileId=FILE_000000003619893&fileDetailSn=1&insertDataPrcus=N
SEOUL_TRANSFER_DISTANCE_EFFECTIVE_FROM=2025-12-31

# [설정값/키 아님] 국가철도공단 도시·광역철도 역사 위치 공식 XLSX
# 위도·경도, 영문 역명과 데이터기준일자를 수집합니다. 공개 파일 다운로드라
# KRIC_API_KEY 및 REST API 일일 호출 예산을 소비하지 않습니다.
KRIC_STATION_COORDINATES_DOWNLOAD_URL=https://openapi.kric.go.kr/rips/dataset/download.file?type=filedata&id=32&operation=1

# [설정값/키 아님] 국가철도공단 철도산업정보센터 운영사별 표준 운행정보 XLSX
# 공개 파일이라 KRIC_API_KEY와 REST API 일일 호출 예산을 소비하지 않습니다.
# 파일 개정 여부는 ETag/Last-Modified와 SHA-256으로 확인하며, 변경된 경우만 활성화합니다.
KRIC_AREX_TIMETABLE_DOWNLOAD_URL=https://openapi.kric.go.kr/rips/dataset/download.file?type=filedata&id=7&operation=1
KRIC_SHINBUNDANG_TIMETABLE_DOWNLOAD_URL=https://openapi.kric.go.kr/rips/dataset/download.file?type=filedata&id=15&operation=1
KRIC_UI_SINSEOL_TIMETABLE_DOWNLOAD_URL=https://openapi.kric.go.kr/rips/dataset/download.file?type=filedata&id=911&operation=1
KRIC_SILLIM_TIMETABLE_DOWNLOAD_URL=https://openapi.kric.go.kr/rips/dataset/download.file?type=filedata&id=1221&operation=1
KRIC_GIMPO_GOLD_TIMETABLE_DOWNLOAD_URL=https://openapi.kric.go.kr/rips/dataset/download.file?type=filedata&id=903&operation=1
KRIC_UIJEONGBU_TIMETABLE_DOWNLOAD_URL=https://openapi.kric.go.kr/rips/dataset/download.file?type=filedata&id=17&operation=1
KRIC_KORAIL_TIMETABLE_DOWNLOAD_URL=https://openapi.kric.go.kr/rips/dataset/download.file?type=filedata&id=6&operation=1

# [설정값/키 아님] 민자·경전철 운영기관의 현재 공식 시간표
# 공항철도 페이지에서는 최신 전체 XLSX 링크를 자동 발견합니다. 특정 파일을
# 고정해야 할 때만 AREX_OFFICIAL_TIMETABLE_DOWNLOAD_URL을 입력합니다.
# 우이신설선·신림선은 역별 HTML 변경 해시, 의정부경전철은 공식 이미지 변경
# 해시와 OCR 품질검사를 사용합니다. 공개 페이지이므로 API 요청 한도를 쓰지 않습니다.
AREX_OFFICIAL_TIMETABLE_PAGE_URL=https://www.airportrailroad.com/train/normal/info/010/0
AREX_OFFICIAL_TIMETABLE_DOWNLOAD_URL=
AREX_OFFICIAL_TIMETABLE_EFFECTIVE_FROM=2025-12-29
UI_SINSEOL_OFFICIAL_PAGE_TEMPLATE=https://www.ui-line.com/html/intro/intro00/intro_00_{station:02d}.php?pGubn=T2
UI_SINSEOL_OFFICIAL_EFFECTIVE_FROM=2022-05-30
SILLIM_OFFICIAL_PAGE_TEMPLATE=https://www.sillimlrt.com/kr/html/sub01/010102{station:02d}.html
SILLIM_OFFICIAL_EFFECTIVE_FROM=2025-09-23
UIJEONGBU_OFFICIAL_TIMETABLE_PAGE_URL=https://www.ulrt.co.kr/doc/contents/information/time.php
UIJEONGBU_OFFICIAL_EFFECTIVE_FROM=2025-12-31
